# ============================================================
# ClickReady Chart Service - Пример переменных окружения
# ============================================================
# Скопируйте этот файл в .env и заполните своими значениями
# Никогда не коммитьте .env в репозиторий!

# Профиль Spring (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Сервер
PORT=8080

# ============================================================
# База данных (PostgreSQL)
# ============================================================
DB_URL=jdbc:postgresql://localhost:5432/chartdb
DB_USERNAME=chart_user
DB_PASSWORD=chart_password

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Kafka
# ============================================================
KAFKA_BOOTSTRAP=localhost:9092

# ============================================================
# JWT (секрет должен быть минимум 256 бит = 32 символа)
# ============================================================
JWT_SECRET=your-super-secret-jwt-key-for-production-min-256-bits
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ============================================================
# Логирование
# ============================================================
LOG_LEVEL=DEBUG
HIBERNATE_SHOW_SQL=false
HIBERNATE_GENERATE_STATS=false

# ============================================================
# Внешние API
# ============================================================
EXTERNAL_API_URL=https://api.example.com
EXTERNAL_API_KEY=your-api-key
EXTERNAL_API_TIMEOUT=30000